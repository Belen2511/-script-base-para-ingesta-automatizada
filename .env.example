# --- Variables del Checkpoint 1 (src/check_env.py) ---
OPENAI_API_KEY=tu_api_key_aqui
MLFLOW_TRACKING_URI=http://localhost:5000
DATABASE_URL=tu_url_aqui

# --- Ingesta (src/main.py) ---
# Open-Meteo es gratuito sin clave. Si tenés un plan comercial, poné la URL
# https://customer-api.open-meteo.com y tu clave; si no, dejá la clave vacía.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=

# Resiliencia
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=1
MAX_CONCURRENCY=5

# Logging: LOG_LEVEL = DEBUG | INFO | WARNING | ERROR ; LOG_FORMAT = text | json
LOG_LEVEL=INFO
LOG_FORMAT=text
